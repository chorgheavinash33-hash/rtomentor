{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/sign-in/[[...index]]",
      "regex": "^/sign\\-in(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPindex": "nxtPindex"
      },
      "namedRegex": "^/sign\\-in(?:/(?<nxtPindex>.+?))?(?:/)?$"
    },
    {
      "page": "/sign-up/[[...index]]",
      "regex": "^/sign\\-up(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPindex": "nxtPindex"
      },
      "namedRegex": "^/sign\\-up(?:/(?<nxtPindex>.+?))?(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/learning-dashboard",
      "regex": "^/learning\\-dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/learning\\-dashboard(?:/)?$"
    },
    {
      "page": "/mock-test",
      "regex": "^/mock\\-test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mock\\-test(?:/)?$"
    },
    {
      "page": "/practice-test",
      "regex": "^/practice\\-test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/practice\\-test(?:/)?$"
    },
    {
      "page": "/question-bank",
      "regex": "^/question\\-bank(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/question\\-bank(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    },
    {
      "page": "/symbol-preparation",
      "regex": "^/symbol\\-preparation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/symbol\\-preparation(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}